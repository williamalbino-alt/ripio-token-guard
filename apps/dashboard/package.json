{
	"name": "@ripio/token-guard",
	"type": "module",
	"version": "1.0.0",
	"description": "Ripio Token Guard — FinOps Dashboard for Claude Code usage",
	"scripts": {
		"dev": "npx -y tsx ./src/index.ts",
		"start": "npx -y tsx ./src/index.ts",
		"format": "pnpm run lint --fix",
		"lint": "eslint --cache .",
		"typecheck": "tsgo --noEmit"
	},
	"bin": {
		"token-guard": "./src/index.ts"
	},
	"files": [
		"src"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"devDependencies": {
		"@hono/node-server": "catalog:runtime",
		"@ryoppippi/eslint-config": "catalog:lint",
		"@typescript/native-preview": "catalog:types",
		"eslint": "catalog:lint",
		"hono": "catalog:runtime",
		"tsx": "catalog:"
	},
	"dependencies": {
		"open": "catalog:"
	}
}
